MIYAPAD_LOGIN="anon"
MIYAPAD_PASSWORD="SET_YOUR_PASSWORD_HERE"
MIYAPAD_STORAGE_PATH="/storage/web-session-storage.db"
# Required for Docker: the server binds to 127.0.0.1 only by default, which is
# unreachable through the container's port mapping. 0.0.0.0 makes it reachable
# from the host; if you're running this directly on your own machine instead
# of in Docker, remove this line to keep the loopback-only default.
MIYAPAD_HOST=0.0.0.0
# MIYAPAD_NO_BACKUP=true
# MIYAPAD_BACKUP_INTERVAL=30
# MIYAPAD_BACKUP_DIR="./backups"
# MIYAPAD_BACKUP_KEEP=10